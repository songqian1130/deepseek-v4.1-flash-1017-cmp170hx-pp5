+def _map_cpu_parameters_to_uva(module: nn.Module) -> None:
+    """Expose CPU-created DSpark head weights through CUDA UVA."""
+    if not current_platform.is_cuda():
+        return
+    from vllm.utils.platform_utils import is_uva_available
+
+    if not is_uva_available():
+        raise RuntimeError("DSpark CPU head construction requires CUDA UVA")
+    from vllm.model_executor.offloader.base import pin_exact, should_pin_memory
+    from vllm.utils.torch_utils import get_accelerator_view_from_cpu_tensor
+
+    for parameter in module.parameters():
+        if parameter.device.type != "cpu":
+            continue
+        cpu_data = parameter.data
+        if should_pin_memory():
+            cpu_data = pin_exact(cpu_data)
+        parameter.data = get_accelerator_view_from_cpu_tensor(cpu_data)
+        parameter._vllm_is_uva_offloaded = True
+
+
